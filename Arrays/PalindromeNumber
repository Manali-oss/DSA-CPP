// Problem: Palindrome Number
// Platform: GeeksforGeeks
// Approach 1: Reverse the number and compare with original ✅ (Implemented below)
// Approach 2: Converting number into the string 
// Approach 3: Doing the same work using a function
// Time Complexity: O(d)  (where d = number of digits)
// Space Complexity: O(1)

#include <bits/stdc++.h>
using namespace std;

class Solution {
  public:
    bool isPalindrome(int n) {
        int real = n;
        int ans = 0;

        while(n)
        {
            int rem = n % 10;
            ans = ans * 10 + rem;
            n = n / 10;
        }

        if(real == ans)
        {
            return 1;
        }
        else
        {
            return 0;
        }
    }
};
