// Problem: Balanced Parentheses
// Platform: GeeksforGeeks
// Difficulty: Easy
// Approach: Use stack to match opening and closing brackets
// Time Complexity: O(n)
// Space Complexity: O(n)

#include <bits/stdc++.h>
using namespace std;

class Solution {
  public:
    bool isBalanced(string& s) {
        
        int n = s.size();
        if(n == 1) return 0;
        
        stack<char> st;
        
        for(int i = 0; i < n; i++)
        {
            if(s[i] == '(' || s[i] == '{' || s[i] == '[')
            {
                st.push(s[i]);
            }
            else if(s[i] == ')' || s[i] == '}' || s[i] == ']')
            {
                // check empty stack
                if(st.empty()) return false;
                
                if((s[i] == ')' && st.top() == '(') ||
                   (s[i] == '}' && st.top() == '{') ||
                   (s[i] == ']' && st.top() == '['))
                {
                    st.pop();
                }
                else{
                    return false;
                }
            }
        }
        
        if(!st.empty())
        {
            return 0;
        }
        
        return 1;
    }
};
